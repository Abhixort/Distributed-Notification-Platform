# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Distributed Notification Platform"
API_V1_STR="/api/v1"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback for lightweight local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/notification_db
# For SQLite local dev: sqlite+aiosqlite:///./notifications.db and sqlite:///./notifications.db

# Redis Configuration (Broker & Rate Limiter & Idempotency Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting (Token Bucket)
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT_CAPACITY=200
DEFAULT_RATE_LIMIT_REFILL_RATE=166.67 # Tokens per second (~10,000 requests/minute)

# Idempotency
IDEMPOTENCY_EXPIRATION_SECONDS=86400 # 24 hours
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=10

# Retry & Fault Tolerance
MAX_NOTIFICATION_RETRIES=5
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
RETRY_EXPONENTIAL_FACTOR=2

# AWS SES / SNS Configuration (Mock mode available when credentials unset)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
SES_SENDER_EMAIL=notifications@platform.internal
USE_MOCK_PROVIDERS=true

# Webhook Delivery
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=10
WEBHOOK_SECRET_KEY=platform-webhook-hmac-secret-key-32-bytes

# Security & API Keys
SECRET_KEY=super-secret-system-key-change-in-production
API_KEY_HEADER_NAME=X-API-Key
MASTER_API_KEY=notif_master_key_super_secret_9999
